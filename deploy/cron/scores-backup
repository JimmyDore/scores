# Sauvegarde nocturne de scores vers Cloudflare R2 (installé par la CI).
# 4:30, décalé des autres sauvegardes du serveur.
# hub-run (installé par le déploiement du hub) signale chaque run à la tâche
# scores-backup de hub.jimmydore.fr, qui alerte sur Slack en cas d'échec.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
30 4 * * * root /usr/local/bin/hub-run scores-backup -- /root/scores/deploy/backup.sh >> /var/log/scores-backup.log 2>&1
